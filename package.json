{
  "name": "hotel-example-site",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "start": "webpack serve",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "bootstrap": "4.6.2",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "copy-webpack-plugin": "14.0.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.8.3",
    "terser-webpack-plugin": "5.5.0",
    "vitest": "^4.0.18",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.3"
  },
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11"
      }
    ]
  }
}
