{
  "name": "hotel-example-site",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "start": "webpack serve",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "vitest run --coverage",
    "test:unit:ci": "PBT_NUM_RUNS=1200000 vitest run --coverage",
    "test:unit:fast": "PBT_NUM_RUNS=100 vitest run",
    "test:smarter:doctor": "circleci run testsuite \"unit tests\" --doctor",
    "test:smarter:bootstrap": "circleci run testsuite \"unit tests\" --local --select-tests=none --analyze-tests=all",
    "test:unit:watch": "vitest",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "bootstrap": "4.6.2",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@circleci/vitest-circleci-coverage": "jsr:^0.1.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.8",
    "copy-webpack-plugin": "14.0.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.1",
    "prettier": "^3.8.3",
    "terser-webpack-plugin": "5.5.0",
    "vitest": "^4.0.18",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.3"
  },
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11"
      }
    ]
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
